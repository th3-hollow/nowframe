[Unit]
Description=NowFrame Local Web Control
After=network-online.target nowframe.service
Wants=network-online.target

[Service]
Type=simple
User=nowframe-control
Group=nowframe-control
WorkingDirectory=/opt/nowframe-control/app

EnvironmentFile=/etc/nowframe/spotify.env

Environment=HOME=/var/lib/nowframe-control
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/nowframe-control/app

Environment=NOWFRAME_CONTROL_FILE=/etc/nowframe/control.env
Environment=NOWFRAME_DEVICE_HISTORY_FILE=/etc/nowframe/devices.json
Environment=NOWFRAME_USAGE_FILE=/var/lib/nowframe/spotify_api_usage.csv
Environment=NOWFRAME_SPOTIFY_CACHE_PATH=/var/lib/nowframe-control/spotify-cache

Environment="NOWFRAME_VALIDATE_COMMAND=/usr/bin/sudo -n /usr/local/sbin/nowframe-control-helper validate"
Environment="NOWFRAME_RESTART_COMMAND=/usr/bin/sudo -n /usr/local/sbin/nowframe-control-helper restart"
Environment="NOWFRAME_CONFIGURE_SPOTIFY_COMMAND=/usr/bin/sudo -n /usr/local/sbin/nowframe-control-helper configure-spotify"

Environment=NOWFRAME_CONTROL_HOST=0.0.0.0
Environment=NOWFRAME_CONTROL_PORT=8080
Environment=NOWFRAME_CONTROL_THREADS=2

ExecStart=/opt/nowframe-control/venv/bin/python -u /opt/nowframe-control/app/control_server.py

Restart=on-failure
RestartSec=5
UMask=0007

PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/nowframe /var/lib/nowframe-control
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
