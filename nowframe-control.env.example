# NowFrame Control web server
NOWFRAME_CONTROL_HOST=0.0.0.0
NOWFRAME_CONTROL_PORT=8080
NOWFRAME_CONTROL_THREADS=2

# Installed paths
NOWFRAME_CONTROL_FILE=/etc/nowframe/control.env
NOWFRAME_DEVICE_HISTORY_FILE=/etc/nowframe/devices.json
NOWFRAME_USAGE_FILE=/var/lib/nowframe/spotify_api_usage.csv
NOWFRAME_SPOTIFY_CACHE_PATH=/var/lib/nowframe-control/spotify-cache

# Restricted privileged actions
NOWFRAME_VALIDATE_COMMAND=/usr/bin/sudo -n /usr/local/sbin/nowframe-control-helper validate
NOWFRAME_RESTART_COMMAND=/usr/bin/sudo -n /usr/local/sbin/nowframe-control-helper restart
