# Spotify developer application credentials
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret

# This must exactly match a redirect URI configured
# in your Spotify developer application.
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: override the persistent Spotipy token cache.
# The default is ~/.nowframe_spotify_cache.
# NOWFRAME_SPOTIFY_CACHE_PATH=/path/to/spotify-token-cache

# Optional: show Spotify playback only for approved devices.
# Device names are case-insensitive and comma-separated.
NOWFRAME_SPOTIFY_DEVICE_FILTER_ENABLED=false
NOWFRAME_ALLOWED_SPOTIFY_DEVICES=
